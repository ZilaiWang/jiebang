{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jiangdongouyang-lab/knowbalance/schemas/role-c-content/learner_profile_snapshot.schema.json",
  "title": "B to C Learner Profile Snapshot",
  "type": "object",
  "required": ["schema_version", "profile_id", "profile_version", "learner_id", "level", "known_concepts", "weak_concepts", "goal", "preferred_contexts", "accommodations"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "profile_id": { "type": "string", "minLength": 1 },
    "profile_version": { "type": "string", "minLength": 1 },
    "learner_id": { "type": "string", "minLength": 1 },
    "level": { "enum": ["beginner", "basic", "intermediate", "integrated"] },
    "known_concepts": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "weak_concepts": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "goal": { "type": "string", "minLength": 1 },
    "goal_profile": { "enum": ["coursework", "algorithm_competition", "job_interview", "general_learning"] },
    "learning_barriers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "barrier", "count"],
        "properties": {
          "source_id": { "type": "string", "minLength": 1 },
          "barrier": { "enum": ["concept_recall", "code_translation", "debugging", "boundary_condition", "problem_understanding", "unknown"] },
          "count": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      }
    },
    "confidence_state": {
      "type": "object",
      "required": ["version", "fields", "answered_question_ids", "round_no"],
      "properties": {
        "version": { "const": "profile-confidence.v1" },
        "fields": { "type": "object" },
        "answered_question_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "round_no": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "preferred_contexts": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "accommodations": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "provenance_ref": { "type": "string" },
    "pedagogy_contract": {
      "type": "object",
      "required": ["schema_version", "source_profile", "locked_core", "learner_state", "lesson", "practice", "assessment", "pacing", "constraints", "rationale"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "source_profile": { "type": "object" },
        "locked_core": { "type": "object" },
        "learner_state": { "type": "object" },
        "lesson": { "type": "object" },
        "practice": { "type": "object" },
        "assessment": { "type": "object" },
        "pacing": { "type": "object" },
        "constraints": { "type": "object" },
        "rationale": { "type": "array", "items": { "type": "string" } }
      }
    },
    "expression_context": { "$ref": "expression_context.schema.json" }
  },
  "additionalProperties": false
}
