{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jiangdongouyang-lab/knowbalance/schemas/role-c-content/grade_feedback.schema.json",
  "title": "Role C Frozen Grade Feedback",
  "type": "object",
  "required": ["generated_after_score_freeze", "mode", "summary", "item_feedback"],
  "properties": {
    "generated_after_score_freeze": { "const": true },
    "mode": { "enum": ["formative", "summative"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "item_feedback": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["item_id", "feedback_code", "message", "next_step"],
        "properties": {
          "item_id": { "type": "string", "minLength": 1 },
          "feedback_code": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "next_step": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "revealed_answer": { "$ref": "#/$defs/revealed_answer" }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "revealed_answer": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "option_id"],
          "properties": {
            "kind": { "const": "choice" },
            "option_id": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "accepted"],
          "properties": {
            "kind": { "const": "text" },
            "accepted": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "target"],
          "properties": {
            "kind": { "const": "numeric" },
            "target": { "type": "number" },
            "unit": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "criteria"],
          "properties": {
            "kind": { "const": "rubric" },
            "criteria": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["description", "required_evidence"],
                "properties": {
                  "description": { "type": "string", "minLength": 1 },
                  "required_evidence": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "string", "minLength": 1 }
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "code"],
          "properties": {
            "kind": { "const": "code" },
            "code": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false
}
