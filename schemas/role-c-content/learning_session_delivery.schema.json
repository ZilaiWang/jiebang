{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jiangdongouyang-lab/knowbalance/schemas/role-c-content/learning_session_delivery.schema.json",
  "title": "Role C Learning Session Delivery",
  "type": "object",
  "required": [
    "schema_version",
    "delivery_kind",
    "delivery_id",
    "session"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "delivery_kind": { "const": "learning_session" },
    "delivery_id": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "session": {
      "oneOf": [
        { "$ref": "#/$defs/preselected" },
        { "$ref": "#/$defs/route_locked" }
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "base_properties": {
      "type": "object",
      "properties": {
        "routing_request_id": { "type": "string", "minLength": 1 },
        "session_id": { "type": "string", "minLength": 1 },
        "run_id": { "type": "string", "minLength": 1 },
        "form_id": { "type": "string", "minLength": 1 },
        "attempt_no": { "type": "integer", "minimum": 1 },
        "required_item_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "preselected": {
      "type": "object",
      "required": [
        "phase",
        "routing_request_id",
        "session_id",
        "run_id",
        "form_id",
        "attempt_no",
        "required_item_ids"
      ],
      "properties": {
        "phase": { "const": "preselected" },
        "routing_request_id": { "$ref": "#/$defs/base_properties/properties/routing_request_id" },
        "session_id": { "$ref": "#/$defs/base_properties/properties/session_id" },
        "run_id": { "$ref": "#/$defs/base_properties/properties/run_id" },
        "form_id": { "$ref": "#/$defs/base_properties/properties/form_id" },
        "attempt_no": { "$ref": "#/$defs/base_properties/properties/attempt_no" },
        "required_item_ids": { "$ref": "#/$defs/base_properties/properties/required_item_ids" }
      },
      "additionalProperties": false
    },
    "route_locked": {
      "type": "object",
      "required": [
        "phase",
        "routing_request_id",
        "session_id",
        "run_id",
        "form_id",
        "attempt_no",
        "route_lock_id",
        "route_id",
        "action",
        "anchor_score_ratio",
        "required_item_ids"
      ],
      "properties": {
        "phase": { "const": "route_locked" },
        "routing_request_id": { "$ref": "#/$defs/base_properties/properties/routing_request_id" },
        "session_id": { "$ref": "#/$defs/base_properties/properties/session_id" },
        "run_id": { "$ref": "#/$defs/base_properties/properties/run_id" },
        "form_id": { "$ref": "#/$defs/base_properties/properties/form_id" },
        "attempt_no": { "$ref": "#/$defs/base_properties/properties/attempt_no" },
        "route_lock_id": { "type": "string", "minLength": 1 },
        "route_id": { "type": "string", "minLength": 1 },
        "action": { "enum": ["remediate", "reinforce", "advance"] },
        "anchor_score_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "required_item_ids": { "$ref": "#/$defs/base_properties/properties/required_item_ids" }
      },
      "additionalProperties": false
    }
  }
}
