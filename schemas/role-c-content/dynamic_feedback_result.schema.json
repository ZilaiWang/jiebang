{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jiangdongouyang-lab/knowbalance/schemas/role-c-content/dynamic_feedback_result.schema.json",
  "title": "C Dynamic Feedback Result",
  "type": "object",
  "required": [
    "schema_version",
    "feedback_id",
    "run_id",
    "session_id",
    "submission_id",
    "learner_id_hash",
    "profile_version",
    "path_node_id",
    "form_id",
    "attempt_no",
    "round_score",
    "objective_results",
    "grade_result",
    "mastery_snapshot",
    "final_decision"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "feedback_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "submission_id": { "type": "string", "minLength": 1 },
    "learner_id_hash": { "type": "string", "minLength": 1 },
    "profile_version": { "type": "string", "minLength": 1 },
    "path_node_id": { "type": "string", "minLength": 1 },
    "form_id": { "type": "string", "minLength": 1 },
    "attempt_no": { "type": "integer", "minimum": 1 },
    "round_score": {
      "type": "object",
      "required": ["raw_score", "max_score", "accuracy", "evidence_score"],
      "properties": {
        "raw_score": { "type": "number", "minimum": 0 },
        "max_score": { "type": "number", "exclusiveMinimum": 0 },
        "accuracy": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence_score": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "objective_results": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/objective_result" }
    },
    "grade_result": { "$ref": "grade_result.schema.json" },
    "mastery_snapshot": {
      "type": "array",
      "items": { "$ref": "#/$defs/mastery_snapshot" }
    },
    "final_decision": { "$ref": "#/$defs/final_decision" },
    "profile_drift_suggestion": { "$ref": "profile_drift_suggestion.schema.json" }
  },
  "additionalProperties": false,
  "$defs": {
    "objective_result": {
      "type": "object",
      "required": [
        "objective_id",
        "raw_score",
        "max_score",
        "accuracy",
        "evidence_score",
        "misconception_tags"
      ],
      "properties": {
        "objective_id": { "type": "string", "minLength": 1 },
        "raw_score": { "type": "number", "minimum": 0 },
        "max_score": { "type": "number", "exclusiveMinimum": 0 },
        "accuracy": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "misconception_tags": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "mastery_snapshot": {
      "type": "object",
      "required": [
        "objective_id",
        "mastery",
        "evidence_batches",
        "observed_modalities",
        "revision"
      ],
      "properties": {
        "objective_id": { "type": "string", "minLength": 1 },
        "mastery": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence_batches": { "type": "integer", "minimum": 0 },
        "observed_modalities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["mcq", "true_false", "trace", "short_answer", "code"] }
        },
        "revision": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "final_decision": {
      "type": "object",
      "required": [
        "action",
        "basis",
        "confidence",
        "reason_codes",
        "target_objective_ids",
        "policy_ref"
      ],
      "properties": {
        "action": { "enum": ["remediate", "reinforce", "advance", "reprofile"] },
        "basis": { "enum": ["round_accuracy", "profile_drift"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "target_objective_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "policy_ref": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
