{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jiangdongouyang-lab/knowbalance/schemas/role-c-content/reviewed_release_delivery.schema.json",
  "title": "Role C Reviewed Release Delivery",
  "type": "object",
  "required": [
    "schema_version",
    "delivery_kind",
    "delivery_id",
    "run_id",
    "pipeline_input_hash",
    "generation_spec_hash",
    "review_policy_version",
    "final_review_hash",
    "artifacts",
    "trace_events",
    "resource_fit"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "delivery_kind": {
      "const": "reviewed_release"
    },
    "delivery_id": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "pipeline_input_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "generation_spec_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "review_policy_version": {
      "type": "string",
      "minLength": 1
    },
    "final_review_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "artifacts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {
          "$ref": "concept_artifact.schema.json"
        },
        {
          "$ref": "code_lab_public.schema.json"
        },
        {
          "$ref": "assessment_public.schema.json"
        }
      ],
      "items": false
    },
    "trace_events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "agent_trace_event.schema.json"
      }
    },
    "adaptation": {
      "type": "object",
      "required": [
        "adaptation_action",
        "target_objective_ids",
        "addressed_misconception_tags",
        "adaptation_summary",
        "source_feedback_refs"
      ],
      "properties": {
        "adaptation_action": {
          "enum": [
            "remediate",
            "reinforce",
            "advance"
          ]
        },
        "target_objective_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "addressed_misconception_tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "adaptation_summary": {
          "type": "string",
          "minLength": 1
        },
        "source_feedback_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "resource_fit": {
      "type": "object",
      "required": [
        "schema_version",
        "run_id",
        "spec_id",
        "profile_ref",
        "policy_version",
        "resources",
        "overall"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "spec_id": {
          "type": "string",
          "minLength": 1
        },
        "profile_ref": {
          "type": "object",
          "required": [
            "profile_id",
            "profile_version",
            "profile_content_hash"
          ],
          "properties": {
            "profile_id": {
              "type": "string",
              "minLength": 1
            },
            "profile_version": {
              "type": "string",
              "minLength": 1
            },
            "profile_content_hash": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "policy_version": {
          "type": "string",
          "minLength": 1
        },
        "resources": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": [
              "artifact_id",
              "kind",
              "target",
              "observed",
              "fit"
            ],
            "properties": {
              "artifact_id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "concept_lesson",
                  "code_lab",
                  "assessment"
                ]
              },
              "target": {
                "type": "object",
                "required": [
                  "challenge",
                  "support"
                ],
                "properties": {
                  "challenge": {
                    "type": "object",
                    "required": [
                      "domain_complexity",
                      "cognitive_demand",
                      "reasoning_steps",
                      "code_complexity",
                      "prerequisite_load"
                    ],
                    "properties": {
                      "domain_complexity": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 5
                      },
                      "cognitive_demand": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 5
                      },
                      "reasoning_steps": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 5
                      },
                      "code_complexity": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 5
                      },
                      "prerequisite_load": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 5
                      },
                      "transfer_distance": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 5
                      },
                      "boundary_condition_density": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 5
                      },
                      "task_composition": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 5
                      }
                    },
                    "additionalProperties": false
                  },
                  "support": {
                    "type": "object",
                    "required": [
                      "scaffold_strength",
                      "reading_density",
                      "hint_strength",
                      "starter_support"
                    ],
                    "properties": {
                      "scaffold_strength": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 5
                      },
                      "reading_density": {
                        "enum": [
                          "low",
                          "medium",
                          "high"
                        ]
                      },
                      "hint_strength": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 5
                      },
                      "starter_support": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 5
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              },
              "observed": {
                "type": "object",
                "required": [
                  "challenge",
                  "support",
                  "confidence"
                ],
                "properties": {
                  "challenge": {
                    "type": "object",
                    "required": [
                      "domain_complexity",
                      "cognitive_demand",
                      "reasoning_steps",
                      "code_complexity",
                      "prerequisite_load"
                    ],
                    "properties": {
                      "domain_complexity": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 5
                      },
                      "cognitive_demand": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 5
                      },
                      "reasoning_steps": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 5
                      },
                      "code_complexity": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 5
                      },
                      "prerequisite_load": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 5
                      },
                      "transfer_distance": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 5
                      },
                      "boundary_condition_density": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 5
                      },
                      "task_composition": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 5
                      }
                    },
                    "additionalProperties": false
                  },
                  "support": {
                    "type": "object",
                    "required": [
                      "scaffold_strength",
                      "reading_density",
                      "hint_strength",
                      "starter_support"
                    ],
                    "properties": {
                      "scaffold_strength": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 5
                      },
                      "reading_density": {
                        "enum": [
                          "low",
                          "medium",
                          "high"
                        ]
                      },
                      "hint_strength": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 5
                      },
                      "starter_support": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 5
                      }
                    },
                    "additionalProperties": false
                  },
                  "confidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "additionalProperties": false
              },
              "fit": {
                "type": "object",
                "required": [
                  "verdict",
                  "score",
                  "mismatched_dimensions",
                  "reason_codes",
                  "dimensions"
                ],
                "properties": {
                  "verdict": {
                    "enum": [
                      "fit",
                      "too_easy",
                      "too_hard",
                      "uncertain"
                    ]
                  },
                  "score": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "mismatched_dimensions": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "reason_codes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "dimensions": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "name",
                        "family",
                        "applicable",
                        "target",
                        "observed",
                        "signed_gap",
                        "weight",
                        "tolerance",
                        "basis"
                      ],
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "family": {
                          "enum": [
                            "challenge",
                            "support"
                          ]
                        },
                        "applicable": {
                          "type": "boolean"
                        },
                        "target": {
                          "type": "number"
                        },
                        "observed": {
                          "type": "number"
                        },
                        "signed_gap": {
                          "type": "number"
                        },
                        "weight": {
                          "type": "number"
                        },
                        "tolerance": {
                          "type": "number"
                        },
                        "basis": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "required": [
                              "feature",
                              "value"
                            ],
                            "properties": {
                              "feature": {
                                "type": "string"
                              },
                              "value": {
                                "type": [
                                  "number",
                                  "string"
                                ]
                              },
                              "source_ref": {
                                "type": "string"
                              }
                            },
                            "additionalProperties": false
                          }
                        }
                      },
                      "additionalProperties": false
                    }
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "overall": {
          "type": "object",
          "required": [
            "verdict",
            "score",
            "aggregation"
          ],
          "properties": {
            "verdict": {
              "enum": [
                "fit",
                "too_easy",
                "too_hard",
                "uncertain"
              ]
            },
            "score": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "aggregation": {
              "type": "object",
              "required": [
                "policy",
                "weighted_mean",
                "weakest_kind",
                "weakest_score",
                "final_score"
              ],
              "properties": {
                "policy": {
                  "enum": [
                    "arithmetic_mean",
                    "weighted_mean",
                    "bottleneck_cap"
                  ]
                },
                "weighted_mean": {
                  "type": "number"
                },
                "weakest_kind": {
                  "enum": [
                    "concept_lesson",
                    "code_lab",
                    "assessment"
                  ]
                },
                "weakest_score": {
                  "type": "number"
                },
                "bottleneck_margin": {
                  "type": "number"
                },
                "final_score": {
                  "type": "number"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}