{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jiangdongouyang-lab/knowbalance/schemas/role-c-content/code_lab_draft.schema.json",
  "title": "C Code Lab Provider Draft",
  "type": "object",
  "required": ["public_draft", "secure_draft"],
  "properties": {
    "public_draft": {
      "type": "object",
      "required": ["payload"],
      "properties": { "payload": { "$ref": "#/$defs/public_payload" } },
      "additionalProperties": false
    },
    "secure_draft": {
      "type": "object",
      "required": ["payload"],
      "properties": { "payload": { "$ref": "#/$defs/secure_payload" } },
      "additionalProperties": false
    }
  },
  "$defs": {
    "public_safety_repair_patch": {
      "type": "object",
      "required": [
        "starter_code",
        "instruction_texts",
        "public_test_descriptions",
        "public_test_expected_behaviors",
        "hint_texts",
        "reflection_questions"
      ],
      "properties": {
        "starter_code": { "type": "string", "minLength": 1 },
        "instruction_texts": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "public_test_descriptions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "public_test_expected_behaviors": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "hint_texts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "reflection_questions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "citation": {
      "type": "object",
      "required": ["source_id", "fact_id", "relation"],
      "properties": {
        "source_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]{0,27}[0-9]{3,6}$" },
        "fact_id": { "type": "string", "pattern": "^F[0-9]{3,6}$" },
        "relation": { "enum": ["supports", "derived_from", "prerequisite"] }
      },
      "additionalProperties": false
    },
    "citation_list": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/citation" }
    },
    "claim": {
      "type": "object",
      "required": ["claim_id", "text", "citations"],
      "properties": {
        "claim_id": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "citations": { "$ref": "#/$defs/citation_list" }
      },
      "additionalProperties": false
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/claim" }
    },
    "paragraph_block": {
      "type": "object",
      "required": ["block_id", "block_type", "text", "claims"],
      "properties": {
        "block_id": { "type": "string", "minLength": 1 },
        "block_type": { "const": "paragraph" },
        "text": { "type": "string", "minLength": 1 },
        "claims": { "$ref": "#/$defs/claims" }
      },
      "additionalProperties": false
    },
    "code_block": {
      "type": "object",
      "required": ["block_id", "block_type", "language", "code", "claims"],
      "properties": {
        "block_id": { "type": "string", "minLength": 1 },
        "block_type": { "const": "code" },
        "language": { "const": "python" },
        "code": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "caption": { "type": "string" },
        "claims": { "$ref": "#/$defs/claims" }
      },
      "additionalProperties": false
    },
    "callout_block": {
      "type": "object",
      "required": ["block_id", "block_type", "tone", "title", "text", "claims"],
      "properties": {
        "block_id": { "type": "string", "minLength": 1 },
        "block_type": { "const": "callout" },
        "tone": { "enum": ["info", "warning", "tip"] },
        "title": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "claims": { "$ref": "#/$defs/claims" }
      },
      "additionalProperties": false
    },
    "instruction_block": {
      "oneOf": [
        { "$ref": "#/$defs/paragraph_block" },
        { "$ref": "#/$defs/code_block" },
        { "$ref": "#/$defs/callout_block" }
      ]
    },
    "hint_ladder": {
      "type": "object",
      "required": ["objective_id", "hints"],
      "properties": {
        "objective_id": { "type": "string", "minLength": 1 },
        "hints": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": ["hint_level", "text", "citations"],
            "properties": {
              "hint_level": { "type": "integer", "minimum": 1, "maximum": 3 },
              "text": { "type": "string", "minLength": 1 },
              "citations": { "$ref": "#/$defs/citation_list" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "execution_contract": {
      "type": "object",
      "required": ["language", "execution_mode", "allowed_imports", "input_contract", "output_contract", "resource_limits"],
      "properties": {
        "language": { "const": "python" },
        "execution_mode": { "enum": ["function", "stdin_stdout"] },
        "entry_point": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "allowed_imports": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["bisect", "collections", "datetime", "decimal", "enum", "fractions", "functools", "heapq", "itertools", "io", "json", "math", "operator", "random", "re", "statistics", "string"]
          }
        },
        "input_contract": {
          "type": "object",
          "required": ["type", "constraints"],
          "properties": {
            "type": { "type": "string", "minLength": 1 },
            "constraints": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          },
          "additionalProperties": false
        },
        "output_contract": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "kind": { "enum": ["string", "number", "array", "object", "boolean"] },
            "type": { "type": "string", "minLength": 1 },
            "constraints": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          },
          "additionalProperties": false
        },
        "resource_limits": {
          "type": "object",
          "required": ["timeout_ms", "memory_mb", "max_output_bytes"],
          "properties": {
            "timeout_ms": { "type": "integer", "minimum": 100, "maximum": 5000 },
            "memory_mb": { "type": "integer", "minimum": 32, "maximum": 512 },
            "max_output_bytes": { "type": "integer", "minimum": 256, "maximum": 100000 }
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": { "properties": { "execution_mode": { "const": "function" } } },
          "then": { "required": ["entry_point"] }
        }
      ],
      "additionalProperties": false
    },
    "public_test": {
      "type": "object",
      "required": ["test_id", "objective_id", "description", "input", "expected_behavior", "citations"],
      "properties": {
        "test_id": { "type": "string", "minLength": 1 },
        "objective_id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "input": {},
        "expected_behavior": { "type": "string", "minLength": 1 },
        "citations": { "$ref": "#/$defs/citation_list" }
      },
      "additionalProperties": false
    },
    "public_coverage": {
      "type": "object",
      "required": ["objective_id", "instruction_block_ids", "public_test_ids"],
      "properties": {
        "objective_id": { "type": "string", "minLength": 1 },
        "instruction_block_ids": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "public_test_ids": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "practical_guide_author": {
      "type": "object",
      "required": ["practice_goal", "deliverable", "readiness_checks", "steps", "troubleshooting", "extension_task"],
      "additionalProperties": false,
      "properties": {
        "practice_goal": { "type": "string", "minLength": 1, "maxLength": 500 },
        "deliverable": { "type": "string", "minLength": 1, "maxLength": 500 },
        "readiness_checks": { "type": "array", "minItems": 1, "maxItems": 3, "items": {
          "type": "object", "required": ["title", "check", "ready_when"], "additionalProperties": false,
          "properties": { "title": { "type": "string", "minLength": 1 }, "check": { "type": "string", "minLength": 1 }, "ready_when": { "type": "string", "minLength": 1 } }
        } },
        "steps": { "type": "array", "minItems": 3, "maxItems": 5, "items": {
          "type": "object", "required": ["title", "action", "input", "expected_result", "verification"], "additionalProperties": false,
          "properties": { "title": { "type": "string", "minLength": 1 }, "action": { "type": "string", "minLength": 1 }, "input": { "type": "string", "minLength": 1 }, "expected_result": { "type": "string", "minLength": 1 }, "verification": { "type": "string", "minLength": 1 } }
        } },
        "troubleshooting": { "type": "array", "minItems": 1, "maxItems": 3, "items": {
          "type": "object", "required": ["symptom", "likely_cause", "recovery_steps", "verification"], "additionalProperties": false,
          "properties": { "symptom": { "type": "string", "minLength": 1 }, "likely_cause": { "type": "string", "minLength": 1 }, "recovery_steps": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "verification": { "type": "string", "minLength": 1 } }
        } },
        "extension_task": { "type": "object", "required": ["task", "changed_dimension", "verification"], "additionalProperties": false,
          "properties": { "task": { "type": "string", "minLength": 1 }, "changed_dimension": { "type": "string", "minLength": 1 }, "verification": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "guide_binding": {
      "type": "object",
      "required": ["slot_id", "objective_id", "citations", "contract_refs", "public_test_ids"],
      "properties": {
        "slot_id": { "type": "string", "minLength": 1 }, "objective_id": { "type": "string", "minLength": 1 },
        "citations": { "type": "array", "items": { "$ref": "#/$defs/citation" } },
        "contract_refs": { "type": "array", "uniqueItems": true, "items": { "enum": ["execution.entry_point", "execution.input_contract", "execution.output_contract", "execution.allowed_imports", "public_tests"] } },
        "public_test_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "practical_guide_public": {
      "type": "object",
      "required": ["schema_version", "guide_id", "plan_id", "lab_id", "practice_goal", "deliverable", "estimated_minutes", "environment", "readiness_checks", "steps", "acceptance_criteria", "troubleshooting", "extension_task", "used_evidence"],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "const": "practical-guide.v1" }, "guide_id": { "type": "string", "minLength": 1 }, "plan_id": { "type": "string", "minLength": 1 }, "lab_id": { "type": "string", "minLength": 1 },
        "practice_goal": { "type": "string", "minLength": 1 }, "deliverable": { "type": "string", "minLength": 1 }, "estimated_minutes": { "type": "integer", "minimum": 10, "maximum": 120 },
        "environment": { "type": "object", "required": ["language", "execution_mode", "entry_point", "input_type", "output_type", "allowed_imports", "tool_constraints"], "additionalProperties": false,
          "properties": { "language": { "const": "python" }, "execution_mode": { "enum": ["function", "stdin_stdout"] }, "entry_point": { "type": ["string", "null"] }, "input_type": { "type": "string", "minLength": 1 }, "output_type": { "type": "string", "minLength": 1 }, "allowed_imports": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }, "tool_constraints": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } } }
        },
        "readiness_checks": { "type": "array", "minItems": 1, "items": { "allOf": [{ "$ref": "#/$defs/guide_binding" }, { "type": "object", "required": ["title", "check", "ready_when"], "properties": { "title": { "type": "string", "minLength": 1 }, "check": { "type": "string", "minLength": 1 }, "ready_when": { "type": "string", "minLength": 1 } } }] } },
        "steps": { "type": "array", "minItems": 3, "maxItems": 5, "items": { "allOf": [{ "$ref": "#/$defs/guide_binding" }, { "type": "object", "required": ["sequence", "title", "action", "input", "expected_result", "verification"], "properties": { "sequence": { "type": "integer", "minimum": 1 }, "title": { "type": "string", "minLength": 1 }, "action": { "type": "string", "minLength": 1 }, "input": { "type": "string", "minLength": 1 }, "expected_result": { "type": "string", "minLength": 1 }, "verification": { "type": "string", "minLength": 1 } } }] } },
        "acceptance_criteria": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["criterion_id", "public_test_id", "objective_id", "description", "expected_behavior"], "additionalProperties": false, "properties": { "criterion_id": { "type": "string", "minLength": 1 }, "public_test_id": { "type": "string", "minLength": 1 }, "objective_id": { "type": "string", "minLength": 1 }, "description": { "type": "string", "minLength": 1 }, "expected_behavior": { "type": "string", "minLength": 1 } } } },
        "troubleshooting": { "type": "array", "minItems": 1, "items": { "allOf": [{ "$ref": "#/$defs/guide_binding" }, { "type": "object", "required": ["symptom", "likely_cause", "recovery_steps", "verification"], "properties": { "symptom": { "type": "string", "minLength": 1 }, "likely_cause": { "type": "string", "minLength": 1 }, "recovery_steps": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "verification": { "type": "string", "minLength": 1 } } }] } },
        "extension_task": { "allOf": [{ "$ref": "#/$defs/guide_binding" }, { "type": "object", "required": ["task", "changed_dimension", "verification"], "properties": { "task": { "type": "string", "minLength": 1 }, "changed_dimension": { "type": "string", "minLength": 1 }, "verification": { "type": "string", "minLength": 1 } } }] },
        "used_evidence": { "type": "array", "items": { "$ref": "#/$defs/citation" } }
      }
    },
    "code_gap_template": {
      "type": "object",
      "required": ["schema_version", "template_code", "gaps"],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "const": "code-gap-template.v1" },
        "template_code": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "gaps": {
          "type": "array", "minItems": 1, "maxItems": 8,
          "items": {
            "type": "object",
            "required": ["gap_id", "label", "kind", "max_chars", "max_lines"],
            "additionalProperties": false,
            "properties": {
              "gap_id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" },
              "label": { "type": "string", "minLength": 1 },
              "kind": { "enum": ["identifier", "literal", "expression", "statement", "block"] },
              "answer_format": { "enum": ["python_string_literal", "python_expression", "python_statement", "python_identifier"] },
              "max_chars": { "type": "integer", "minimum": 1, "maximum": 20000 },
              "max_lines": { "type": "integer", "minimum": 1, "maximum": 100 },
              "placeholder": { "type": "string" }
            }
          }
        }
      }
    },
    "programming_task_author": {
      "type": "object",
      "required": ["statement", "input_description", "output_description", "constraints"],
      "additionalProperties": false,
      "properties": {
        "statement": { "type": "string", "minLength": 20, "maxLength": 4000 },
        "input_description": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "output_description": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "constraints": { "type": "array", "minItems": 2, "maxItems": 12, "items": { "type": "string", "minLength": 1 } },
        "gap_template": { "$ref": "#/$defs/code_gap_template" },
        "additional_public_examples": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "type": "object", "required": ["description", "input", "expected_behavior"], "additionalProperties": false, "properties": { "description": { "type": "string", "minLength": 1 }, "input": {}, "expected_behavior": { "type": "string", "minLength": 1 } } } }
      }
    },
    "programming_task_public": {
      "type": "object",
      "required": ["schema_version", "task_id", "blueprint_id", "task_kind", "submission_mode", "statement", "input_description", "output_description", "constraints", "public_examples", "hint_ladders"],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "const": "programming-task.v1" },
        "task_id": { "type": "string", "minLength": 1 },
        "blueprint_id": { "type": "string", "minLength": 1 },
        "task_kind": { "enum": ["code_completion", "function_implementation", "stdin_stdout_program", "debugging_repair"] },
        "submission_mode": { "enum": ["full_code", "gap_answers"] },
        "statement": { "type": "string", "minLength": 20 },
        "input_description": { "type": "string", "minLength": 1 },
        "output_description": { "type": "string", "minLength": 1 },
        "constraints": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
        "starter_code": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "gap_template": { "$ref": "#/$defs/code_gap_template" },
        "public_examples": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["case_id", "description", "input", "expected_behavior"], "additionalProperties": false, "properties": { "case_id": { "type": "string", "minLength": 1 }, "description": { "type": "string", "minLength": 1 }, "input": {}, "expected_behavior": { "type": "string", "minLength": 1 } } } },
        "hint_ladders": { "type": "array", "minItems": 3, "items": { "type": "object", "required": ["level", "text"], "additionalProperties": false, "properties": { "level": { "type": "integer", "minimum": 1, "maximum": 3 }, "text": { "type": "string", "minLength": 1 } } } }
      }
    },
    "public_author_payload": {
      "type": "object",
      "required": ["title", "execution_contract", "starter_code", "objectives", "practical_guide"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "execution_contract": { "$ref": "#/$defs/execution_contract" },
        "starter_code": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "practical_guide": { "$ref": "#/$defs/practical_guide_author" },
        "programming_task": { "$ref": "#/$defs/programming_task_author" },
        "objectives": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "instruction_text",
              "public_test",
              "hints",
              "reflection_question"
            ],
            "properties": {
              "instruction_text": { "type": "string", "minLength": 1 },
              "public_test": {
                "type": "object",
                "required": ["description", "input", "expected_behavior"],
                "properties": {
                  "description": { "type": "string", "minLength": 1 },
                  "input": {},
                  "expected_behavior": { "type": "string", "minLength": 1 }
                },
                "additionalProperties": false
              },
              "hints": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": { "type": "string", "minLength": 1 }
              },
              "reflection_question": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "public_payload": {
      "type": "object",
      "required": ["lab_id", "title", "objective_ids", "instructions", "execution_contract", "starter_code", "public_tests", "hint_ladders", "reflection_questions", "objective_coverage", "used_evidence"],
      "properties": {
        "lab_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "objective_ids": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "instructions": {
          "type": "array", "minItems": 1,
          "items": { "$ref": "#/$defs/instruction_block" }
        },
        "execution_contract": { "$ref": "#/$defs/execution_contract" },
        "starter_code": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "public_tests": {
          "type": "array", "minItems": 1,
          "items": { "$ref": "#/$defs/public_test" }
        },
        "hint_ladders": {
          "type": "array", "minItems": 1,
          "items": { "$ref": "#/$defs/hint_ladder" }
        },
        "reflection_questions": {
          "type": "array", "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "practical_guide": { "$ref": "#/$defs/practical_guide_public" },
        "programming_task": { "$ref": "#/$defs/programming_task_public" },
        "objective_coverage": {
          "type": "array", "minItems": 1,
          "items": { "$ref": "#/$defs/public_coverage" }
        },
        "used_evidence": { "$ref": "#/$defs/citation_list" }
      },
      "additionalProperties": false
    },
    "test_comparison": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "properties": { "kind": { "const": "exact" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "abs_tolerance", "rel_tolerance"],
          "properties": {
            "kind": { "const": "numeric" },
            "abs_tolerance": { "type": "number", "minimum": 0 },
            "rel_tolerance": { "type": "number", "minimum": 0 }
          },
          "additionalProperties": false
        }
      ]
    },
    "hidden_test": {
      "type": "object",
      "required": ["test_id", "input", "expected", "objective_id", "weight", "comparison"],
      "properties": {
        "test_id": { "type": "string", "minLength": 1 },
        "input": {},
        "expected": {},
        "objective_id": { "type": "string", "minLength": 1 },
        "weight": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "comparison": { "$ref": "#/$defs/test_comparison" }
        ,"partition_id": { "enum": ["nominal", "boundary", "anti_hardcode", "error_path"] }
        ,"note": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "scoring_group": {
      "type": "object",
      "required": ["group_id", "objective_id", "test_ids", "weight"],
      "properties": {
        "group_id": { "type": "string", "minLength": 1 },
        "objective_id": { "type": "string", "minLength": 1 },
        "test_ids": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "weight": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "mutation_variant": {
      "type": "object",
