{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RAG Retrieval Result",
  "type": "object",
  "required": ["query", "topK", "results"],
  "additionalProperties": false,
  "properties": {
    "query": { "type": "string" },
    "learnerLevel": { "type": "string", "enum": ["beginner", "basic", "intermediate", "integrated"] },
    "topK": { "type": "number" },
    "retrieval_id": { "type": "string", "minLength": 1 },
    "match_status": { "enum": ["strong", "weak", "no_match"] },
    "retrieval_context": { "type": "object" },
    "objective_coverage": { "type": "array" },
    "evidence_sufficiency": { "$ref": "#/definitions/evidenceSufficiency" },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sourceId",
          "source_id",
          "title",
          "difficulty",
          "score",
          "reason",
          "snippet",
          "facts",
          "examples",
          "practiceTasks",
          "quizItems",
          "file",
          "retrievalTrace",
          "retrieval_trace"
        ],
        "additionalProperties": false,
        "properties": {
          "sourceId": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]{0,27}[0-9]{3,6}$" },
          "source_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]{0,27}[0-9]{3,6}$" },
          "title": { "type": "string" },
          "difficulty": { "type": "string", "enum": ["beginner", "basic", "intermediate", "integrated"] },
          "score": { "type": "number" },
          "reason": { "type": "string" },
          "snippet": { "type": "string" },
          "facts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["sourceId", "factId", "source_id", "fact_id", "content"],
              "additionalProperties": false,
              "properties": {
                "sourceId": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]{0,27}[0-9]{3,6}$" },
                "factId": { "type": "string", "pattern": "^F[0-9]{3,6}$" },
                "source_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]{0,27}[0-9]{3,6}$" },
                "fact_id": { "type": "string", "pattern": "^F[0-9]{3,6}$" },
                "content": { "type": "string" },
                "scope": { "type": "array", "items": { "type": "string" } },
                "exceptions": { "type": "array", "items": { "type": "string" } },
                "prerequisites": { "type": "array", "items": { "type": "string" } },
                "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
                "authority": { "enum": ["curriculum", "official_documentation", "reviewed_reference"] },
                "capabilities": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": { "enum": ["definition", "rule", "procedure", "state_transition", "boundary", "contrast", "io_contract", "example"] }
                }
              }
            }
          },
          "coreFactIds": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^F[0-9]{3,6}$" }
          },
          "examples": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["title", "code", "explanation"],
              "additionalProperties": false,
              "properties": {
                "title": { "type": "string" },
                "code": { "type": "string" },
                "explanation": { "type": "string" }
              }
            }
          },
          "practiceTasks": { "type": "array", "items": { "type": "string" } },
          "quizItems": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["level", "type", "question", "answer", "sourceId", "factId"],
              "additionalProperties": false,
              "properties": {
                "level": { "type": "number" },
                "type": { "type": "string" },
                "question": { "type": "string" },
                "options": { "type": "array", "items": { "type": "string" } },
                "answer": { "type": "string" },
                "sourceId": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]{0,27}[0-9]{3,6}$" },
                "factId": { "type": "string", "pattern": "^F[0-9]{3,6}$" }
              }
            }
          },
          "misconceptions": {
            "type": "array",
            "items": { "$ref": "#/definitions/misconception" }
          },
          "workedExamples": {
            "type": "array",
            "items": { "$ref": "#/definitions/workedExample" }
          },
          "counterexamples": { "type": "array", "items": { "type": "string" } },
          "assessmentConstraints": { "type": "array", "items": { "type": "string" } },
          "file": { "type": "string" },
          "retrievalTrace": { "$ref": "#/definitions/retrievalTrace" },
          "retrieval_trace": { "$ref": "#/definitions/retrievalTraceJson" }
        }
      }
    }
  },
  "definitions": {
    "evidenceSufficiency": {
      "type": "object",
      "required": ["ok", "missing_source_ids", "missing_fact_ids", "missing_misconception_ids", "worked_example_count", "counterexample_count"],
      "additionalProperties": false,
      "properties": {
        "ok": { "type": "boolean" },
        "missing_source_ids": { "type": "array", "items": { "type": "string" } },
        "missing_fact_ids": { "type": "array", "items": { "type": "string" } },
        "missing_misconception_ids": { "type": "array", "items": { "type": "string" } },
        "worked_example_count": { "type": "integer", "minimum": 0 },
        "counterexample_count": { "type": "integer", "minimum": 0 }
      }
    },
    "scoreBreakdown": {
      "type": "object",
      "required": ["keyword", "title", "facts", "practiceTasks", "difficulty", "bonus"],
      "additionalProperties": false,
      "properties": {
        "keyword": { "type": "number" },
        "title": { "type": "number" },
        "facts": { "type": "number" },
        "practiceTasks": { "type": "number" },
        "difficulty": { "type": "number" },
        "bonus": { "type": "number" },
        "bm25": { "type": "number" },
        "vector": { "type": "number" },
        "metadata": { "type": "number" },
        "misconception": { "type": "number" }
      }
    },
    "misconception": {
      "type": "object",
      "required": ["misconceptionId", "incorrectBelief", "diagnosticSignals", "counterexample", "correctionStrategy", "distractorTemplates", "factRefs"],
      "additionalProperties": false,
      "properties": {
        "misconceptionId": { "type": "string" },
        "incorrectBelief": { "type": "string" },
        "diagnosticSignals": { "type": "array", "items": { "type": "string" } },
        "counterexample": { "type": "string" },
        "correctionStrategy": { "type": "string" },
        "distractorTemplates": { "type": "array", "items": { "type": "string" } },
        "factRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["sourceId", "factId"],
            "additionalProperties": false,
            "properties": {
              "sourceId": { "type": "string" },
              "factId": { "type": "string" }
            }
          }
        }
      }
    },
    "workedExample": {
      "type": "object",
      "required": ["title", "problem", "steps", "boundaryCases", "fadingLevel"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "problem": { "type": "string" },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["action", "rationale", "factIds"],
            "additionalProperties": false,
            "properties": {
              "action": { "type": "string" },
              "rationale": { "type": "string" },
              "factIds": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "boundaryCases": { "type": "array", "items": { "type": "string" } },
        "fadingLevel": { "type": "integer", "minimum": 0, "maximum": 3 }
      }
    },
    "retrievalTrace": {
      "type": "object",
      "required": ["matchedKeywords", "matchedFields", "difficultyMatch", "scoreBreakdown"],
      "additionalProperties": false,
      "properties": {
        "matchedKeywords": { "type": "array", "items": { "type": "string" } },
        "matchedFields": { "type": "array", "items": { "type": "string" } },
        "difficultyMatch": { "type": "boolean" },
        "scoreBreakdown": { "$ref": "#/definitions/scoreBreakdown" }
      }
    },
    "retrievalTraceJson": {
      "type": "object",
      "required": ["matched_keywords", "matched_fields", "difficulty_match", "score_breakdown"],
      "additionalProperties": false,
      "properties": {
        "matched_keywords": { "type": "array", "items": { "type": "string" } },
        "matched_fields": { "type": "array", "items": { "type": "string" } },
        "difficulty_match": { "type": "boolean" },
        "score_breakdown": { "$ref": "#/definitions/scoreBreakdown" }
      }
    }
  }
}
